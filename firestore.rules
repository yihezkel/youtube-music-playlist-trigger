rules_version = '2';

// Everything the app and console touch lives under the signed-in user's own
// subtree, so a single ownership check covers config, state, commands and
// uploaded logs. Uploaded logs can contain playlist ids and device
// diagnostics, so there is no public read anywhere.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Anything outside a user subtree is denied by default.
  }
}
