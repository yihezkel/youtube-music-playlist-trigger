# Build outputs
build/
app/build/
.gradle/
local.properties

# IDE
.idea/
*.iml
.vscode/

# Logs / temp
*.log
obj/
out/

# OS
.DS_Store
Thumbs.db

# Keystore
*.keystore
*.jks

# Research artifacts not meant for the repo
musicscreen*.txt
*.flo
CopilotPromptsInVsCode.txt

# Firebase project config — identifies your project, so keep it out of a
# public repo. CI injects it from the GOOGLE_SERVICES_JSON secret.
app/google-services.json
.firebaserc
.firebase/

# Service-account private key for the log fetcher, and whatever it pulls down.
# The key grants admin access to the Firebase project — never commit it.
tools/service-account.json

# Which spreadsheet and which phone. Not secrets on their own — the Firestore
# rules and the sheet's sharing both deny anonymous access — but this repo is
# public, so there is no reason to publish the other half of the pair.
# Copy tools/ids.example.json to get started.
tools/ids.local.json
tools/node_modules/
.remote-logs/


# Generated podcast statistics (regenerate with tools/podcast-stats.mjs)
tools/podcast-stats.json
tools/_*.mjs

# Aleph Beta feed rebuilt from their published metadata: personal use, not for
# redistribution, and the token makes the hosted path unguessable.
tools/.ab-cache/
tools/.ab-feed-token
web/private-feeds/
tools/private-feeds.json

# Per-workspace MCP servers (Aleph Beta member library). Not committed.
.mcp.json
tools/.ab-mcp/
tools/.ab-feed-slugs.json
tools/.ab-missing.json
